{
  "schema": "guildhall.workflow/1",
  "name": "human-review",
  "description": "The default workflow with the Guildmaster reviewing the plan and every change instead of an automated reviewer.",
  "steps": [
    {"id": "grill", "type": "grill", "version": 1, "settings": {"actor": "director"}},
    {"id": "plan", "type": "plan", "version": 1,
     "inputs": {"context": ["grill.notes"]}},
    {"id": "design-review", "type": "document-review", "version": 1,
     "settings": {"actor": "guildmaster", "instructions": "Check the plan is small enough to review in one sitting."},
     "inputs": {"subject": ["plan.spec"]},
     "on": {"changes_requested": {"goto": "plan", "max": 2}}},
    {"id": "accept", "type": "guildmaster-approval", "version": 1,
     "inputs": {"spec": ["plan.spec"], "reviews": ["design-review.outcome"]},
     "on": {"changes_requested": {"goto": "plan", "max": 3}}},
    {"id": "build", "type": "build", "version": 1,
     "inputs": {"spec": ["accept.spec"]}},
    {"id": "review", "type": "review", "version": 1,
     "settings": {"actor": "guildmaster", "instructions": "Check the change against the accepted spec before approving."},
     "inputs": {"spec": ["accept.spec"], "head": ["build.head"]},
     "on": {"changes_requested": {"goto": "build", "max": 3}}},
    {"id": "publish", "type": "publish", "version": 1,
     "inputs": {"head": ["build.head"], "review": ["review.outcome"]}},
    {"id": "validate", "type": "validate", "version": 1,
     "inputs": {"head": ["publish.head"]},
     "on": {"failed": {"goto": "build", "max": 3}}},
    {"id": "deliver", "type": "deliver", "version": 1,
     "inputs": {"head": ["publish.head"], "review": ["review.outcome"], "validation": ["validate.result"]}}
  ]
}

{
  "schema": "guildhall.workflow/1",
  "name": "fake-straight",
  "description": "The straight path for the fake Artisan, whose stage guides carry its directives: plan, Guildmaster acceptance, build, a Guildmaster sign-off and delivery under the approval merge policy.",
  "steps": [
    {"id": "plan", "type": "plan", "version": 1, "settings": {"profile": "demo"}},
    {"id": "accept", "type": "guildmaster-approval", "version": 1,
     "inputs": {"spec": ["plan.spec"]}},
    {"id": "build", "type": "build", "version": 1, "settings": {"profile": "demo"},
     "inputs": {"spec": ["accept.spec"]}},
    {"id": "sign-off", "type": "review", "version": 1, "settings": {"actor": "guildmaster"},
     "inputs": {"spec": ["accept.spec"], "head": ["build.head"]}},
    {"id": "deliver", "type": "deliver", "version": 1,
     "inputs": {"head": ["build.head"], "review": ["sign-off.outcome"]}}
  ]
}

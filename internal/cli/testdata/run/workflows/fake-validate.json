{
  "schema": "guildhall.workflow/1",
  "name": "fake-validate",
  "description": "The fake Artisan's straight path with publish and validate: plan, Guildmaster acceptance, build, a Guildmaster sign-off, publish, validation of the published head's checks and delivery under the approval merge policy.",
  "steps": [
    {"id": "plan", "type": "plan", "version": 1, "settings": {"profile": "demo"}},
    {"id": "accept", "type": "guildmaster-approval", "version": 1,
     "inputs": {"spec": ["plan.spec"]}},
    {"id": "build", "type": "build", "version": 1, "settings": {"profile": "demo"},
     "inputs": {"spec": ["accept.spec"]}},
    {"id": "sign-off", "type": "review", "version": 1, "settings": {"actor": "guildmaster"},
     "inputs": {"spec": ["accept.spec"], "head": ["build.head"]}},
    {"id": "publish", "type": "publish", "version": 1,
     "inputs": {"head": ["build.head"], "review": ["sign-off.outcome"]}},
    {"id": "validate", "type": "validate", "version": 1,
     "inputs": {"head": ["publish.head"]}},
    {"id": "deliver", "type": "deliver", "version": 1,
     "inputs": {"head": ["publish.head"], "review": ["sign-off.outcome"], "validation": ["validate.result"]}}
  ]
}

{{define "head"}}<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="same-origin">
<title>{{.}}</title>
{{end}}

{{define "where"}}{{with .Where}}{{if .Lead}}<p class="ws{{if .You}} you{{end}}"><b>{{.Lead}}</b>{{if .Rest}} {{.Rest}}{{end}}{{if .Meta}}<span class="m">{{.Meta}}</span>{{end}}</p>{{end}}{{end}}{{end}}

{{define "chips"}}{{if or .Status.PR .Status.CI}}<ul class="chips">{{with .Status.PR}}<li>{{if $.Status.PRHref}}<a href="{{$.Status.PRHref}}">PR #{{.Number}}</a>{{else}}PR #{{.Number}}{{end}} {{if .Merged}}merged{{else}}open{{end}}</li>{{end}}{{if .Status.CI}}<li>CI <span class="c-{{.Status.CIClass}}">{{.Status.CI}}</span></li>{{end}}</ul>{{end}}{{end}}

{{define "status"}}<dl class="kv"><dt>Where it stands</dt><dd>{{if .Open}}<span class="tag you">Waiting for you</span> · {{.Open}} {{plural .Open "ask" "asks"}}{{else}}{{.Status.Stands}}{{end}}</dd>
{{- if .Status.Step}}<dt>Step</dt><dd><b>{{.Status.Step}}</b>{{if .SliceOf}} · {{.SliceOf}}{{end}}</dd>{{end}}
{{- if .Status.Attempt}}<dt>Last attempt</dt><dd><span title="{{.Status.AttemptRaw}}">{{.Status.Attempt}}</span> · {{.Status.AttemptWhen}}</dd>{{end}}
{{- if .Status.Talk}}<dt>Talk</dt><dd>{{.Status.Talk}}</dd>{{end}}
<dt>PR</dt><dd>{{with .Status.PR}}{{if $.Status.PRHref}}<a href="{{$.Status.PRHref}}">#{{.Number}}</a>{{else}}#{{.Number}}{{end}} · {{if .Merged}}merged{{else}}open{{end}}{{else}}none{{end}}</dd>
<dt>CI</dt><dd>{{if .Status.CI}}<span class="tag {{.Status.CIClass}}">{{.Status.CI}}</span>{{else}}no checks recorded{{end}}</dd>
{{- if .Status.Slices}}<dt>Slices</dt><dd><ul class="sl">{{range .Status.Slices}}<li{{if .Current}} class="cur"{{end}}>{{.Index}}. {{.Title}} · {{.State}}{{if .PR}} · {{if .PRHref}}<a href="{{.PRHref}}">#{{.PR.Number}}</a>{{else}}#{{.PR.Number}}{{end}}{{end}}</li>{{end}}</ul></dd>{{end}}
{{- range .Crumbs}}<dt>{{.Label}}</dt><dd><a href="{{.Href}}">{{.Name}}</a></dd>{{end}}
</dl>
{{- if .Status.Waits}}<p class="asof">Waiting on the Director:</p><ul class="waits">{{range .Status.Waits}}<li>{{.}}</li>{{end}}</ul>{{end}}
<p class="asof">Read from the store at {{.ReadAt}} · reload for newer</p>{{end}}

{{define "ask"}}<div class="ask{{if .Deferred}} def{{end}}{{if .Refused}} refused{{end}}{{if .Sent}} sent{{end}}" id="{{.ID}}">
{{- if .Form}}<form method="post" action="{{.Action}}"><input type="hidden" name="decision" value="{{.ID}}"><input type="hidden" name="subject" value="{{.Digest}}"><input type="hidden" name="token" value="{{.Token}}">{{end}}
<div class="ah"><span class="kind">{{.KindName}}</span><a class="aid" href="#{{.ID}}">#{{.ID}}</a>{{if .Chip}}<a class="tg" href="{{.ChipHref}}">{{.Chip}}</a>{{end}}{{if .Deferred}}<span class="tag you">deferred</span>{{end}}{{if .Since}}<span class="since">{{.Since}}</span>{{end}}</div>
<p class="q">{{.First}}</p>
{{- template "explanation" .}}
{{- if .Plan}}{{if .Summary}}<div class="plan md"><p class="ph">Summary</p>{{.Summary}}{{with .Questions}}{{template "questions" .}}{{end}}</div>{{else}}<p class="subj"><a href="{{.SubjectHref}}">No summary in this spec · read {{.SubjectName}}</a></p>{{with .Questions}}<div class="plan md">{{template "questions" .}}</div>{{end}}{{end}}{{else}}{{with .Questions}}<div class="plan md">{{template "questions" .}}</div>{{end}}{{end}}
{{- if or .Subject .ReadLink .MockupHref}}<p class="subj">{{if .Subject}}About <code>{{.Subject}}</code>{{end}}{{if .ReadLink}}{{if .Subject}} · {{end}}<a href="{{.SubjectHref}}">read {{.SubjectName}}</a>{{end}}{{if .MockupHref}}{{if or .Subject .ReadLink}} · {{end}}<a href="{{.MockupHref}}" target="_blank" rel="noopener">{{.MockupLabel}}</a>{{end}}</p>{{end}}
{{- if .Mockup}}<div class="plan md"><p class="ph">Mock-up</p>{{.Mockup}}</div>{{end}}
{{- if .Rest}}<details class="ctx"><summary>The rest of the question</summary><div><pre>{{.Rest}}</pre></div></details>{{end}}
{{- if .Findings}}<details class="ctx"><summary>{{.FindingsSummary}}</summary><div><ul class="find">{{range .Findings}}<li>{{if .Rule}}<span class="sev">{{.Rule}}</span>{{end}}<span><b>{{.ID}}</b> {{.Summary}}</span></li>{{end}}</ul></div></details>{{end}}
{{- if .Talk}}<div class="talk" id="{{.TalkID}}"><p class="pick">Talk on #{{.ID}}</p>{{range .Talk}}{{template "msg" .}}{{end}}{{with .Confirm}}{{template "confirm" .}}{{end}}</div>{{else}}{{with .Confirm}}{{template "confirm" .}}{{end}}{{end}}
{{- if .StaleRecommendation}}<p class="recst">{{.StaleRecommendation}}</p>{{end}}
{{- if .Refused}}<p class="state bad"><b>Refused · nothing written:</b> {{.Refused}}.</p>{{end}}
{{- if .Sent}}<p class="state ok"><b>Words only sent:</b> your words reached the Director as a message; nothing is answered.</p>{{end}}
{{- if .Form}}<label class="yw" for="w-{{.ID}}">Your words <span>{{.Hint}}</span></label><textarea id="w-{{.ID}}" name="text" rows="3">{{if or .Words .Refused}}{{.Words}}{{else}}{{.Prefill}}{{end}}</textarea>
{{- else if .Words}}<p class="yw">Your words, kept</p><textarea rows="3" readonly>{{.Words}}</textarea>{{end}}
{{- template "answers" .}}
{{- if .Form}}<div class="wo"><button class="opt" type="submit" name="send" value="words"><b>Send words only</b><span>answers nothing; your words reach the Director as a message</span></button></div>{{end}}
<p class="who">{{if .Deferred}}Deferred: still yours, for later. {{end}}{{if .Form}}Answering as <b>{{.Login}}</b> · your Tailscale login{{else}}Only the Guildmaster's Tailscale login can answer here{{if .Login}}; you are {{.Login}}{{end}}. Answer in chat or with <code>guildhall decide answer</code>.{{end}}</p>
{{- if .Form}}</form>{{end}}
</div>{{end}}

{{/* explanation: the Director's explanation of an ask, under its headline and above its summary, or the grey note
saying there is none or it is for an earlier version; one block of its own, so talk on the ask can sit beneath it. */}}
{{define "explanation"}}<div class="dx">{{if .Explained}}<p class="dxh">From the Director{{if .ExplainedAt}} · <time>{{.ExplainedAt}}</time>{{end}}</p><div class="md">{{.Explained}}</div>{{else}}<p class="dxn">{{.ExplainNote}}</p>{{end}}</div>{{end}}

{{/* questions and answers: the one layout of an ask's question cards and its answer row (questions.go); every ask
that shows questions or answers draws them through these two, so a change here changes them all. */}}
{{define "questions"}}{{if .None}}<p class="ph">Open questions: none.</p>{{else}}{{if .Controls}}<p class="ph oqh">Open questions · {{.Answered}} of {{.Count}} answered</p>{{else}}<p class="ph oqh">Open questions <span class="n">{{.Count}}</span></p>{{end}}<div class="oqs{{if .Controls}} ctl{{end}}">
{{- range .Cards}}
<section class="oq{{if $.Controls}} rq{{if .Folded}} done{{end}}{{end}}"{{if .ID}} id="{{.ID}}"{{end}}><p class="qt"><span class="qn">Q{{.N}}</span>{{.Title}}</p>
{{- if .Folded}}<p class="rdone"><b>{{.Done}}</b> <span class="gist">{{.Gist}}</span>{{if $.Form}}<button class="lnk" type="submit" name="act" value="change-{{.N}}">Change</button>{{end}}</p>
{{- else}}{{if .Body}}<div class="qb">{{.Body}}</div>{{end}}
{{- if .Pick}}{{$n := .N}}<ul class="ol pk">{{range .Rows}}<li{{if .Rec}} class="rec"{{end}}><label for="p-{{$.Ask}}-{{$n}}-{{.Letter}}"><input type="radio" id="p-{{$.Ask}}-{{$n}}-{{.Letter}}" name="pick-{{$n}}" value="{{if not .Rec}}{{.Letter}}{{end}}"{{if .Checked}} checked{{end}}><span class="lt">{{.Mark}}</span><span class="ot">{{.Text}}{{if .Why}}<span class="why">{{.Why}}</span>{{end}}{{if not .Rec}}<span class="ya">Your answer: Q{{$n}} → {{.Mark}}</span>{{end}}</span>{{if .Rec}}<i class="badge">Recommended</i>{{end}}</label></li>{{end}}</ul>
{{- else if .Rows}}<ul class="ol">{{range .Rows}}<li{{if .Rec}} class="rec"{{end}}>{{if .Mark}}<span class="lt">{{.Mark}}</span>{{end}}<span class="ot">{{.Text}}{{if .Why}}<span class="why">{{.Why}}</span>{{end}}</span>{{if .Rec}}<i class="badge">Recommended</i>{{end}}</li>{{end}}</ul>{{end}}
{{- if .Verbatim}}<div class="qv">{{.Verbatim}}</div>{{end}}{{if .More}}<div class="qm">{{.More}}</div>{{end}}
{{- if $.Form}}<label class="yw" for="{{.ID}}-w">Your words <span>saved by every button</span></label><textarea id="{{.ID}}-w" name="text-{{.N}}" rows="2">{{.Words}}</textarea>{{if .Saved}}<p class="saved">{{.Saved}}</p>{{end}}
<div class="opts">{{if .Rec}}<button class="opt pos rec" type="submit" name="act" value="accept-{{.N}}"><b>Accept recommendation</b><span>{{.Rec}}</span></button>{{end}}<button class="opt" type="submit" name="act" value="words-{{.N}}"><b>Answer with my words</b><span>the words above are the answer</span></button></div>{{end}}{{end}}</section>
{{- end}}
{{- if .Cut}}<p class="cut">(cut; read the document)</p>{{end}}
{{- if .Form}}<div class="opts"><button class="opt" type="submit" name="act" value="save"><b>Save, answer later</b><span>saves every box; nothing is answered</span></button></div>{{end}}</div>{{end}}{{end}}

{{define "answers"}}{{if .Tiles}}<p class="pick">Answer</p>
<div class="opts">{{range .Tiles}}{{if $.Form}}<button class="opt{{if .Tone}} {{.Tone}}{{end}}{{if .Rec}} rec{{end}}" type="submit" name="option" value="{{.Option}}">{{else}}<button class="opt{{if .Tone}} {{.Tone}}{{end}}{{if .Rec}} rec{{end}}" type="button" disabled>{{end}}<b>{{.Word}}{{if .Rec}} <i class="badge">Recommended</i>{{end}}</b>{{if .Text}}<span>{{.Text}}</span>{{end}}{{if .Picked}}<span class="pkd">{{.Picked}}</span>{{end}}</button>{{end}}</div>{{end}}
{{- if and .Form (not .Tiles)}}<div class="opts"><button class="opt pos" type="submit" name="send" value="answer"><b>Answer with your words</b><span>your words are the answer</span></button></div>{{end}}{{end}}

{{define "msg"}}{{if .Round}}{{template "roundrow" .}}{{else if .Summary}}{{template "summaryrow" .}}{{else}}<div class="{{.Class}}"><div class="mh"><b>{{.Who}}</b>{{if .Src}}<span class="src">{{.Src}}</span>{{end}}{{if .Rec}}<span class="rk">recommends <b>{{.Rec}}</b></span>{{end}}{{if .Time}}<time>{{.Time}}</time>{{end}}</div><div class="mb">{{.Body}}</div></div>{{end}}{{end}}

{{/* roundrow: a grill round folded into one Director row, sent with its answers or not sent
(docs/web.md#grill-rounds). */}}
{{define "roundrow"}}<div class="{{.Class}}"{{with .Round}} id="{{.ID}}"{{end}}><div class="mh"><b>{{.Who}}</b>{{if .Time}}<time>{{.Time}}</time>{{end}}</div><div class="mb">{{with .Round}}<details class="fold{{if .Void}} void{{end}}"><summary>{{.Line}}</summary>
{{- if .Bad}}<div class="md">{{.Bad}}</div>{{end}}
{{- range .Questions}}<div class="rqa"><p class="qt"><span class="qn">Q{{.N}}</span>{{.Title}}</p>{{if .Body}}<div class="qb">{{.Body}}</div>{{end}}<p class="rrec">Recommended: <b>{{.Rec}}</b></p>
{{- if $.Round.Sent}}<p class="ra">{{if .Accepted}}✓ Accepted{{else}}✓ Your words{{end}}</p>{{if .Answer}}<div class="md">{{.Answer}}</div>{{end}}{{end}}</div>{{end}}</details>{{end}}</div></div>{{end}}

{{/* summaryrow: a grill summary folded into one Director row, answered with its outcome and words or not
answered (docs/web.md#grill-summary). */}}
{{define "summaryrow"}}<div class="{{.Class}}"{{with .Summary}} id="{{.ID}}"{{end}}><div class="mh"><b>{{.Who}}</b>{{if .Time}}<time>{{.Time}}</time>{{end}}</div><div class="mb">{{with .Summary}}<details class="fold{{if .Void}} void{{end}}"><summary>{{.Line}}</summary><div class="md">{{.Body}}</div>
{{- if .Outcome}}<p class="ra">✓ {{.Outcome}}</p>{{if .Answer}}<div class="md">{{.Answer}}</div>{{end}}{{end}}</details>{{end}}</div></div>{{end}}

{{/* summary: the open grill summary as one card, Confirm or Request changes with the Guildmaster's words
(docs/web.md#grill-summary). */}}
{{define "summary"}}<div class="ask summary{{if .Refused}} refused{{end}}" id="{{.ID}}">
{{- if .Form}}<form method="post" action="{{.Action}}"><input type="hidden" name="tag" value="{{.Tag}}"><input type="hidden" name="summary" value="{{.Number}}"><input type="hidden" name="token" value="{{.Token}}">{{end}}
<div class="ah"><span class="kind">{{.Name}}</span><a class="aid" href="#{{.ID}}">#{{.Tag}}</a><a class="tg" href="#{{.Tag}}-talk">{{.Chip}}</a>{{if .Since}}<span class="since">{{.Since}}</span>{{end}}</div>
<p class="q">The Director closes the grill with this summary of what you agreed. Confirm it, or request changes in your words.</p>
<div class="plan md">{{.Body}}</div>
{{- if .Refused}}<p class="state bad"><b>Refused · nothing sent:</b> {{.Refused}}.</p>{{end}}
{{- if .Form}}<label class="yw" for="{{.ID}}-w">Your words <span>what to change; optional with Confirm</span></label><textarea id="{{.ID}}-w" name="text" rows="3">{{.Words}}</textarea>
<div class="opts"><button class="opt pos rec" type="submit" name="act" value="confirm"><b>Confirm</b><span>the Director writes the notes from it and finishes the grill</span></button><button class="opt carry" type="submit" name="act" value="changes"><b>Request changes</b><span>your words say what to change; the interview carries on</span></button></div>{{end}}
<p class="who">{{if .Form}}Answering as <b>{{.Login}}</b> · your Tailscale login{{else}}Only the Guildmaster's Tailscale login can answer here{{if .Login}}; you are {{.Login}}{{end}}.{{end}}</p>
{{- if .Form}}</form>{{end}}
</div>{{end}}

{{/* round: the open grill round as one form, where every button saves every box first
(docs/web.md#grill-rounds). */}}
{{define "round"}}<div class="ask round{{if .Refused}} refused{{end}}" id="{{.ID}}">
{{- if .Form}}<form method="post" action="{{.Action}}"><input type="hidden" name="tag" value="{{.Tag}}"><input type="hidden" name="round" value="{{.Number}}"><input type="hidden" name="drafts" value="{{.Drafts}}"><input type="hidden" name="token" value="{{.Token}}">{{end}}
<div class="ah"><span class="kind">{{.Name}}</span><a class="aid" href="#{{.ID}}">#{{.Tag}}</a><a class="tg" href="#{{.Tag}}-talk">{{.Chip}}</a><span class="since">{{.Progress}} answered</span></div>
<p class="q">The Director asks {{.Total}} {{plural .Total "question" "questions"}}; answer each, then Send round.</p>
{{- if .Bad}}<div class="plan md">{{.Bad}}</div>{{end}}
{{- range .Questions}}
<section class="oq rq{{if .Folded}} done{{end}}" id="{{.ID}}"><p class="qt"><span class="qn">Q{{.N}}</span>{{.Title}}</p>
{{- if .Folded}}<p class="rdone"><b>{{.Done}}</b> <span class="gist">{{.Gist}}</span>{{if $.Form}}<button class="lnk" type="submit" name="act" value="change-{{.N}}">Change</button>{{end}}</p>
{{- else}}{{if .Body}}<div class="qb">{{.Body}}</div>{{end}}<p class="rrec">Recommended: <b>{{.Rec}}</b></p>
{{- if $.Form}}<label class="yw" for="{{.ID}}-w">Your words <span>saved by every button</span></label><textarea id="{{.ID}}-w" name="text-{{.N}}" rows="2">{{.Words}}</textarea>{{if .Saved}}<p class="saved">{{.Saved}}</p>{{end}}
<div class="opts"><button class="opt pos rec" type="submit" name="act" value="accept-{{.N}}"><b>Accept recommendation</b><span>{{.Rec}}</span></button><button class="opt" type="submit" name="act" value="words-{{.N}}"><b>Answer with my words</b><span>the words above are the answer</span></button></div>{{end}}{{end}}</section>
{{- end}}
{{- if .Refused}}<p class="state bad"><b>Refused · nothing sent:</b> {{.Refused}}.</p>{{end}}
{{- if .Form}}<div class="rbar"><button class="opt" type="submit" name="act" value="save"><b>Save, send later</b><span>saves every box; nothing is sent</span></button>{{if .Acceptable}}<button class="opt rec" type="submit" name="act" value="accept-all"><b>Accept all recommendations</b><span>accepts every question with an empty box; your words are kept</span></button>{{end}}<button class="opt pos" type="submit" name="act" value="send"><b>Send round</b><span>{{if .Left}}{{.Left}} still to answer{{else}}every question answered; the Director carries on{{end}}</span></button></div>{{end}}
<p class="who">{{if .Form}}Answering as <b>{{.Login}}</b> · your Tailscale login{{else}}Only the Guildmaster's Tailscale login can answer here{{if .Login}}; you are {{.Login}}{{end}}.{{end}}</p>
{{- if .Form}}</form>{{end}}
</div>{{end}}

{{/* confirm: the Director's recommendation as one tile of the ask's form, which answers with its option and the
words box below (docs/web.md#confirm-and-say). */}}
{{define "confirm"}}<div class="recd"><p class="ph">Recommended by the Director</p><div class="opts">{{if .Form}}<button class="opt rec{{if .Tone}} {{.Tone}}{{end}}" type="submit" name="confirm" value="{{.Number}}">{{else}}<button class="opt rec{{if .Tone}} {{.Tone}}{{end}}" type="button" disabled>{{end}}<b>Confirm: {{.Word}}</b><span>answers #{{.Decision}} with {{.Word}} and your words below</span></button></div></div>{{end}}

{{define "talk"}}<div class="talk"{{if .ID}} id="{{.ID}}"{{end}}><p class="th">Talk on <a class="tg" href="#{{.Tag}}-talk">{{.Chip}}</a>{{if or .Shown .Earlier}} · oldest first{{end}}</p>
{{- if .Earlier}}<details class="fold"><summary>{{len .Earlier}} earlier {{plural (len .Earlier) "message" "messages"}} on {{.Tag}}</summary><div class="talk">{{range .Earlier}}{{template "msg" .}}{{end}}</div></details>{{end}}
{{- range .Shown}}{{template "msg" .}}{{end}}
{{- with .Say}}{{template "say" .}}{{end}}</div>{{end}}

{{define "say"}}<form class="say" id="say" method="post" action="{{.Action}}"><input type="hidden" name="tag" value="{{.Tag}}"><input type="hidden" name="token" value="{{.Token}}">
{{- if .Refused}}<p class="state bad"><b>Refused · nothing sent:</b> {{.Refused}}.</p>{{end}}
{{- if .Said}}<p class="state ok"><b>Sent:</b> your words reached the Director as a message; its reply shows in this talk.</p>{{end}}
<label class="yw" for="say-text">Say to the Director about {{.Tag}} <span>answers nothing</span></label><textarea id="say-text" name="text" rows="3">{{.Words}}</textarea>
<div class="wo"><button class="opt" type="submit"><b>Send to the Director</b><span>answers nothing; your words reach the Director, who replies here</span></button></div></form>{{end}}

{{/* newbar: the new-reply bar at the top of Now, hidden until poll.js shows it, so with scripts off it never
appears; the script fills only the tag, the time and Reload's link, with textContent and setAttribute
(docs/web.md#the-new-reply-bar). */}}
{{define "newbar"}}<div class="newbar" id="newbar" hidden data-since="{{.Since}}" data-base="{{.Base}}" data-last="{{.Last}}" data-start="{{.Start}}">
<p class="nbm" hidden>New from the Director on <b class="nbt"></b> · <time class="nbw"></time> · <a class="nbr" href="{{.Base}}">Reload</a></p>
<p class="nbs" hidden><b>This page is out of date:</b> Guildhall restarted since it loaded, so its forms would be refused. <a href="{{.Base}}">Reload</a> before you answer.</p></div>{{end}}

{{define "gone"}}<div class="ask refused" id="{{if .ID}}{{.ID}}{{else}}not-recorded{{end}}">
<div class="ah"><span class="kind">{{.KindName}}</span>{{if .ID}}<a class="aid" href="#{{.ID}}">#{{.ID}}</a>{{end}}</div>
<p class="q">{{.First}}</p>
<p class="state bad"><b>Refused · nothing written:</b> {{.Refused}}.</p>
{{- if .Words}}<p class="yw">Your words, kept</p><textarea rows="3" readonly>{{.Words}}</textarea>{{end}}
</div>{{end}}

{{define "node"}}<li class="node {{.Class}}"{{if .ID}} id="{{.ID}}"{{end}}><div class="nh"><span class="t"{{if .Raw}} title="{{.Raw}}"{{end}}>{{.Title}}</span>{{if .Word}}<span class="st">{{.Word}}</span>{{end}}{{if .Time}}<time>{{.Time}}</time>{{end}}</div>
{{- if .Body}}<div class="nb">{{.Body}}</div>{{end}}
{{- if .Findings}}<ul class="find">{{range .Findings}}<li>{{if .Rule}}<span class="sev">{{.Rule}}</span>{{end}}<span><b>{{.ID}}</b> {{.Summary}}</span>{{if .Fixed}}<span class="fx">fixed</span>{{end}}</li>{{end}}</ul>{{end}}
{{- range .Said}}<div class="said{{if .Back}} back{{end}}">“{{.Text}}”{{if .Where}}<small>{{.Where}}</small>{{end}}</div>{{end}}
{{- if .TalkNote}}<div class="nb">{{.TalkNote}}</div>{{end}}
{{- if .Talk}}<details class="fold talkf"><summary>Talk · {{len .Talk}} {{plural (len .Talk) "message" "messages"}}</summary><div class="talk">{{range .Talk}}{{template "msg" .}}{{end}}</div></details>{{end}}
{{- if or .Docs .Ask}}<div class="links">{{range .Docs}}<a class="att" href="{{.Href}}" title="{{.Name}}">{{.Label}}</a>{{end}}{{if .Ask}}<a class="flag" href="#{{.Ask}}">Answer #{{.Ask}} above ↑</a>{{end}}</div>{{end}}
{{- if .Events}}<details class="fold raw"><summary>Raw events · {{len .Events}}</summary><pre>{{range $i, $e := .Events}}{{if $i}}
{{end}}{{$e}}{{end}}</pre></details>{{end}}</li>{{end}}

{{define "task"}}{{template "head" (printf "%s · %s" .T.ID .T.Title)}}<style>{{.Style}}</style>{{range .Scripts}}<script>{{.}}</script>{{end}}</head>
<body>
<header class="band">
<div class="crumb"><a href="/">All tasks</a><span class="sep">/</span><span>{{.T.Repository}}</span><span class="sep">/</span><b>{{.T.ID}}</b><span class="sep">·</span><span>{{.T.State}}</span>{{range .Crumbs}}<span class="sep">·</span><span>{{.Label}} <a href="{{.Href}}">{{.Name}}</a></span>{{end}}</div>
<h1>{{.T.Title}}</h1>
{{template "where" .}}{{with .T.Grill}}
<p class="gm">{{.}}</p>{{end}}
{{template "chips" .}}
<ol class="steps">{{range .Steps}}<li class="{{.State}}"{{if .Raw}} title="{{.Raw}}"{{end}}><b>{{.Name}}</b>{{.Note}}</li>{{end}}</ol>
</header>
<div class="c2-body">
<aside class="c2-rail">
<section class="r-status"><h2>Status</h2>
{{template "status" .}}
</section>
<section class="r-need"><h2>Needs you <span class="n{{if .Open}} you{{end}}">{{.Open}}</span></h2>{{if or .Asks .Round .Summary}}<ul class="nix">{{range .Asks}}{{if not .Deferred}}<li><a href="#{{.ID}}">{{if .Phrase}}<b>{{.Phrase}}</b>{{else}}<b>{{.KindName}}</b> {{if .SubjectName}}{{.SubjectName}}{{else if .Subject}}{{.Subject}}{{else}}{{range $i, $t := .Tiles}}{{if $i}}, {{end}}{{$t.Option}}{{end}}{{end}}{{end}}<span>#{{.ID}}</span></a></li>{{end}}{{end}}{{with .Round}}<li><a href="#{{.ID}}"><b>{{.Name}}</b> · {{.Progress}}<span>#{{.Tag}}</span></a></li>{{end}}{{with .Summary}}<li><a href="#{{.ID}}"><b>{{.Name}}</b><span>#{{.Tag}}</span></a></li>{{end}}</ul>{{end}}{{if not .Open}}<p class="empty">Nothing needs you on this task.</p>{{end}}</section>
<section class="r-task"><h2>The task · in your words</h2>
{{range .Context}}<blockquote class="w">“{{.Text}}”<cite>{{.Cite}}</cite></blockquote>{{else}}<p class="empty">No words of yours are recorded on this task.</p>{{end}}
{{with .Grill}}{{if .HTML}}<details class="fold"><summary>What the grill decided · {{.Count}} {{plural .Count "decision" "decisions"}}</summary><div class="grill md">{{.HTML}}</div><a class="flink" href="{{.Href}}">Read {{.Name}}</a></details>{{else}}<a class="flink" href="{{.Href}}">What the grill decided · read {{.Name}}</a>{{end}}{{end}}
</section>
<section class="r-docs"><h2>Documents <span class="n">{{.DocCount}}</span></h2>{{if .Docs}}<ul class="dix">{{range .Docs}}{{$k := .Kind}}{{range $i, $d := .Docs}}<li{{if $d.Old}} class="old"{{end}}><span class="k">{{if not $i}}{{$k}}{{end}}</span><a href="{{$d.Href}}" title="{{$d.Name}}">{{$d.Label}}</a><span class="d">{{$d.Day}}</span></li>{{end}}{{end}}</ul>{{else}}<p class="empty">No documents yet.</p>{{end}}</section>
</aside>
<section class="c2-now"><ol class="spine"><li class="node {{if .Open}}you{{else}}ok{{end}}"><div class="nh"><span class="t">Now</span><span class="st">{{if .Open}}waiting on you · {{.Open}} {{plural .Open "ask" "asks"}}{{else}}nothing waits on you{{end}}</span>{{if .Since}}<time>{{.Since}}</time>{{end}}</div>
{{with .Poll}}{{template "newbar" .}}
{{end}}{{if and .Round .Status.Stage}}<p class="stage">The Director runs {{.Status.Stage}} with you; its {{lower .Round.Name}} is below, to answer here.</p>{{else if and .Summary .Status.Stage}}<p class="stage">The Director runs {{.Status.Stage}} with you; its grill summary is below, to confirm here.</p>{{else if .Status.Stage}}<p class="stage">The Director runs {{.Status.Stage}} with you in its session; answer it there.</p>{{end}}
{{with .Gone}}{{template "gone" .}}{{end}}
{{range .Asks}}{{template "ask" .}}{{end}}{{with .Round}}{{template "round" .}}
{{end}}{{with .Summary}}{{template "summary" .}}
{{end}}
{{if .Closed}}<p class="stage done">{{.Closed}}</p>{{else if not (or .Asks .Round .Summary)}}{{if not .Status.Stage}}<p class="empty">{{.Status.Stands}}</p>{{end}}{{end}}
{{range .Talks}}{{template "talk" .}}{{end}}
</li></ol></section>
<section class="c2-story"><h2>The story · newest first</h2>
<ul class="key"><li><span class="dot">✓</span>finished</li><li><span class="dot back">↩&#xFE0E;</span>sent back</li><li><span class="dot run">▸</span>running</li><li><span class="dot you"></span>waiting on you</li><li><span class="dot later"></span>later</li></ul>
<ol class="spine">
{{range .Story}}{{template "node" .}}{{end}}
{{if .Older}}<li><details class="older"><summary>{{len .Older}} earlier {{plural (len .Older) "entry" "entries"}}{{if .OlderDay}} · from {{.OlderDay}}{{end}}</summary><ol class="spine">{{range .Older}}{{template "node" .}}{{end}}</ol></details></li>{{end}}
</ol>
</section>
</div>
</body></html>
{{end}}

{{define "reader"}}{{template "head" (printf "%s · %s" .Doc.Name .T.ID)}}<style>{{.Style}}</style>{{range .Scripts}}<script>{{.}}</script>{{end}}</head>
<body>
<header class="band slim">
<div class="rtop"><a class="backto" href="{{.Base}}">← Back to the task</a><div><p class="dname">{{.Doc.Name}}</p><div class="crumb">{{.T.Repository}} / {{.T.ID}} · {{.T.Title}}</div></div></div>
<div class="dmeta">{{if .Doc.Kind}}<span>{{.Doc.Kind}}{{if .Doc.Step}} · {{.Doc.Step}}{{end}}</span><span>·</span>{{end}}{{if .Doc.Recorded}}<span>recorded {{.Doc.Recorded}}</span><span>·</span>{{end}}<span class="okk">✓ sha256 matches the record</span><span>·</span><a href="{{.Doc.RawHref}}">Raw</a></div>
</header>
<nav class="jump"><a class="jb" href="{{.Base}}">← {{.T.ID}}</a><a class="jn" href="#needs">Needs you · {{.Open}} · below ↓</a></nav>
<div class="r-body">
<div class="r-doc">{{if .Frame}}<iframe sandbox src="{{.Doc.FrameHref}}" title="{{.Doc.Name}}"></iframe>{{else if .HTML}}<article class="md">{{.HTML}}</article>{{else}}<pre class="txt">{{.Text}}</pre>{{end}}</div>
<aside class="r-side">
<section id="needs"><h2>Needs you <span class="n{{if .Open}} you{{end}}">{{.Open}}</span></h2>
{{if .Status.Stage}}<p class="stage">The Director runs {{.Status.Stage}} with you in its session; answer it there.</p>{{end}}
{{range .Asks}}{{template "ask" .}}{{else}}<p class="empty">Nothing needs you on this task.</p>{{end}}
</section>
<section><h2>Status</h2>
{{template "status" .}}
</section>
<div class="endback"><a class="backto" href="{{.Base}}">← Back to the task</a></div>
</aside>
</div>
</body></html>
{{end}}

{{define "strip"}}<details class="strip" id="stats" open><summary>{{.Summary}}</summary><div class="stb">
<section class="stc" aria-label="Work"><h2>Work</h2><ul><li><b>{{.Running}}</b></li><li>{{.StartQueue}}</li><li>{{.MergeQueue}}{{range $i, $f := .Fronts}}{{if $i}},{{else}} · front{{end}} <a href="{{$f.Href}}">{{$f.Name}}</a>{{end}}</li><li>{{.Merged}}</li></ul></section>
<section class="stc" aria-label="Spend"><h2>Spend <span class="sd">{{.Day}}</span></h2><ul><li><b>{{.Cost}}</b>{{with .CostNote}} <span class="sd">{{.}}</span>{{end}}</li><li>{{.Attempts}}</li><li>{{.Tokens}}</li></ul></section>
<section class="stc" aria-label="Machine"><h2>Machine</h2><ul><li><b>{{.Load}}</b> · {{.Cores}}</li><li>{{.Memory}}</li><li>{{.Disk}}</li></ul></section>
</div></details>{{end}}

{{define "time"}}<time datetime="{{.ISO}}" title="{{.Title}}">{{.Text}}</time>{{end}}

{{define "row"}}<li class="r{{if .You}} you{{end}}{{if .Front}} front{{end}}"><span class="idc">{{if .Position}}<span class="qp">{{.Position}}</span>{{end}}<a class="tid" href="{{.Href}}">{{if .Repo}}<span class="rp">{{.Repo}}</span>{{end}}{{.ID}}</a></span><span class="rt" title="{{.Title}}">{{.Title}}</span>{{if .Pri}}<span class="pri {{.Pri}}">{{.Pri}}</span>{{else}}<span></span>{{end}}<span class="stp">{{if .Held}}<span class="hm">held</span>{{end}}{{if .Step}}<b>{{.Step}}</b>{{end}}{{.Rest}}</span><span class="sx">{{if .Slice}}<span class="lb">slice </span>{{.Slice}}{{end}}</span><span class="prc">{{with .PR}}{{if $.PRHref}}<a href="{{$.PRHref}}">#{{.Number}}</a>{{else}}#{{.Number}}{{end}}{{if $.CI.Mark}}<i class="ci {{$.CI.Class}}" title="{{$.CI.Word}}">{{$.CI.Mark}}</i>{{end}}{{end}}</span>{{with .Time}}{{template "time" .}}{{else}}<span></span>{{end}}{{if .Ask}}<span class="ak">{{.Ask}}</span>{{end}}</li>{{end}}

{{define "chip"}}<a class="cp{{if .On}} on{{end}}" href="{{.Href}}">{{.Label}}{{if .Count}}<i>{{.Count}}</i>{{end}}</a>{{end}}

{{define "sorthead"}}<a class="{{if .On}}on{{if .Desc}} desc{{end}}{{end}}" href="{{.Href}}">{{.Head}}</a>{{end}}

{{define "group"}}<details class="{{.Class}}" id="{{.ID}}"{{if ne .ID "g-done"}} open{{end}}><summary><h2>{{.Title}} <span class="n">{{len .Rows}}</span></h2><span class="sgm">{{.Status}}</span></summary>
{{range .Banners}}<p class="hold"><b>{{.Front}}</b> {{.Wait}}{{with .Since}} since {{template "time" .}}{{end}}.</p>
{{end}}<ul class="rows">
{{range .Rows}}{{template "row" .}}
{{end}}</ul></details>
{{end}}

{{define "list"}}{{template "head" "All tasks"}}<style>{{.Style}}</style>{{range .Scripts}}<script>{{.}}</script>{{end}}</head>
<body>
<header class="band list">
<div class="crumb"><b>All tasks</b></div>
<h1>All tasks</h1>
<p class="ws{{if .You}} you{{end}}"><b>{{.Count}}</b><span class="m">{{.Meta}} · updated {{template "time" .ReadAt}}</span></p>
</header>
<main class="tl tri">
{{template "strip" .Strip}}
{{if .Needs}}<section class="sg you" id="g-you"><div class="sgh"><h2>Needs you <span class="n you">{{len .Needs}}</span></h2><span class="sgm">oldest ask first</span></div><ul class="rows">
{{range .Needs}}{{template "row" .}}
{{end}}</ul></section>
{{end}}
{{- if .Open}}<form class="fb" action="/" method="get" role="search"><input class="fq" type="search" name="q" value="{{.Query.Q}}" placeholder="Filter by id or title" aria-label="Filter by id or title">
{{- if .Query.P}}<input type="hidden" name="p" value="{{.Query.P}}">{{end}}
{{- if .Query.Repo}}<input type="hidden" name="repo" value="{{.Query.Repo}}">{{end}}
{{- if .Query.Sort}}<input type="hidden" name="sort" value="{{.Query.Sort}}">{{end}}
{{- if .Query.Desc}}<input type="hidden" name="dir" value="desc">{{end}}
<div class="fc"><span class="fl">Priority</span>{{range .Priorities}}{{template "chip" .}}{{end}}</div>
{{- if .Repos}}
<div class="fc"><span class="fl">Repository</span>{{range .Repos}}{{template "chip" .}}{{end}}</div>
{{- end}}
</form>
<div class="fc sortp"><span class="fl">Sort</span>{{range .Sorts}}<a class="cp{{if .On}} on{{end}}" href="{{.Href}}">{{.Chip}}{{if .On}}{{if .Desc}} ▴{{else}} ▾{{end}}{{end}}</a>{{end}}</div>
<div class="rh">{{template "sorthead" index .Sorts 0}}<span>Title</span>{{template "sorthead" index .Sorts 1}}{{template "sorthead" index .Sorts 2}}<span>Slice</span>{{template "sorthead" index .Sorts 3}}{{template "sorthead" index .Sorts 4}}</div>
{{end}}
{{- range .Groups}}{{template "group" .}}{{end}}
{{- with .Finished}}{{template "group" .}}{{end}}
{{- if .NoneMatches}}<p class="empty">No task matches the filter. <a href="{{.Clear}}">Show every task</a></p>
{{else if not (or .Needs .Groups .Finished)}}<p class="empty">No task is open, and none finished in the last 24 hours.</p>
{{end}}
<p class="asof">Read from the store {{template "time" .ReadAt}} · reload for newer</p>
</main>
</body></html>
{{end}}

{{define "refusal"}}{{template "head" .Title}}<style>{{.Style}}</style></head>
<body><main class="refusal"><h1>{{.Title}}</h1><p>{{.Words}}</p></main></body></html>
{{end}}

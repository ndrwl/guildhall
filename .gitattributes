# Check out text with LF endings on every platform so gofmt agrees on Windows.
* text=auto eol=lf

# Store fixtures are bbolt files, never text.
*.store binary

# Message envelope fixtures keep the exact bytes and encodings Windows tools write.
internal/messaging/testdata/*.json binary

# Captured terminal screens keep the exact CR and escape bytes Herdr printed.
*.ansi binary

# Skills ship with exact LF bytes because their tree digests pin them.
skills/** text eol=lf

# The release baseline ships with exact LF bytes because its digest golden pins them.
baseline/** text eol=lf
